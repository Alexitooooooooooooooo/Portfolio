---
interface Social {
  name: string;
  label?: string;
  url: string;
  icon: string;
}

interface ContactInfo {
  emails: string[];
  phones: string[];
}

interface Props {
  contact: ContactInfo;
  socials: Social[];
}

const { contact, socials } = Astro.props;

const handle = (url: string) => {
  try {
    const parsed = new URL(url);
    const segments = parsed.pathname.split("/").filter(Boolean);
    const last = segments[segments.length - 1] || parsed.hostname.replace("www.", "");
    return last.startsWith("@") ? last : `@${last}`;
  } catch {
    return url;
  }
};
---

<section class="space-y-8 sm:space-y-10">
  <div class="space-y-3">
    <h2 class="text-2xl sm:text-3xl font-bold text-white flex items-center gap-3">
      Contacto
      <div class="h-px bg-gradient-to-r from-portfolio-muted/50 to-transparent flex-grow ml-4"></div>
    </h2>
    <p class="text-sm sm:text-base text-zinc-400 leading-relaxed max-w-2xl">
      ¿Buscas un desarrollador para tu equipo, quieres colaborar en un proyecto o simplemente hablar de tecnología? Escríbeme y con gusto conversamos.
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
    {contact.emails.length > 0 && (
      <div class="group sm:col-span-2 flex items-center gap-4 p-4 sm:p-5 bg-portfolio-panel border border-white/5 rounded-2xl hover:border-portfolio-accent/40 transition-all duration-300">
        <span class="flex items-center justify-center w-11 h-11 sm:w-12 sm:h-12 shrink-0 rounded-xl bg-white/5 border border-white/5 group-hover:bg-portfolio-accent/10 group-hover:border-portfolio-accent/20 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-portfolio-muted group-hover:text-portfolio-accent transition-colors">
            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
        </span>
        <div class="min-w-0 flex-1">
          <span class="block text-xs sm:text-sm font-mono uppercase tracking-[0.15em] text-portfolio-muted mb-1">Email</span>
          <a
            href={`mailto:${contact.emails[0]}`}
            class="inline-block max-w-full text-lg sm:text-2xl md:text-3xl font-semibold text-white break-all border-b-2 border-portfolio-accent/50 hover:border-portfolio-accent hover:text-portfolio-accent transition-colors"
          >
            {contact.emails[0]}
          </a>
          {contact.emails.slice(1).map(email => (
            <a
              href={`mailto:${email}`}
              class="mt-2 block text-xs sm:text-sm text-portfolio-muted font-mono break-all hover:text-portfolio-accent transition-colors"
            >
              {email}
            </a>
          ))}
        </div>
      </div>
    )}

    {contact.phones.length > 0 && (
      <div class="group sm:col-span-2 flex items-center gap-4 p-4 sm:p-5 bg-portfolio-panel border border-white/5 rounded-2xl hover:border-portfolio-accent/40 transition-all duration-300">
        <span class="flex items-center justify-center w-11 h-11 sm:w-12 sm:h-12 shrink-0 rounded-xl bg-white/5 border border-white/5 group-hover:bg-portfolio-accent/10 group-hover:border-portfolio-accent/20 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-portfolio-muted group-hover:text-portfolio-accent transition-colors">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
        </span>
        <div class="min-w-0 flex-1">
          <span class="block text-xs sm:text-sm font-mono uppercase tracking-[0.15em] text-portfolio-muted mb-1">Teléfono</span>
          <a
            href={`tel:${contact.phones[0]}`}
            class="inline-block max-w-full text-lg sm:text-2xl md:text-3xl font-semibold text-white break-all border-b-2 border-portfolio-accent/50 hover:border-portfolio-accent hover:text-portfolio-accent transition-colors"
          >
            {contact.phones[0]}
          </a>
          {contact.phones.slice(1).map(phone => (
            <a
              href={`tel:${phone}`}
              class="mt-2 block text-xs sm:text-sm text-portfolio-muted font-mono break-all hover:text-portfolio-accent transition-colors"
            >
              {phone}
            </a>
          ))}
        </div>
      </div>
    )}

    {socials.map(social => (
      <a
        href={social.url}
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center gap-4 p-4 bg-portfolio-panel border border-white/5 rounded-2xl hover:border-portfolio-accent/40 hover:-translate-y-0.5 hover:shadow-xl hover:shadow-portfolio-accent/5 transition-all duration-300"
      >
        <span class="flex items-center justify-center w-11 h-11 sm:w-12 sm:h-12 shrink-0 rounded-xl bg-white/5 border border-white/5 group-hover:bg-portfolio-accent/10 group-hover:border-portfolio-accent/20 transition-colors">
          {social.icon && (
            <span
              class="w-5 h-5 sm:w-6 sm:h-6 bg-current text-portfolio-muted group-hover:text-portfolio-accent transition-colors"
              style={`-webkit-mask:url('${social.icon}') center / contain no-repeat; mask:url('${social.icon}') center / contain no-repeat;`}
              aria-hidden="true"
            ></span>
          )}
        </span>
        <span class="min-w-0">
          <span class="block font-semibold text-white group-hover:text-portfolio-accent transition-colors">{social.name}</span>
          <span class="block text-xs sm:text-sm text-portfolio-muted font-mono break-all leading-tight">{social.label || handle(social.url)}</span>
        </span>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-auto shrink-0 text-portfolio-muted group-hover:text-portfolio-accent group-hover:translate-x-0.5 transition-all">
          <line x1="7" y1="17" x2="17" y2="7"></line>
          <polyline points="7 7 17 7 17 17"></polyline>
        </svg>
      </a>
    ))}
  </div>
</section>
