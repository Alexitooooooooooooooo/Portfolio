---
import { technologies } from "../data/config";

interface ExperienceItem {
  company: string;
  role: string;
  date: string;
  desc: string;
  techs: string[];
}

interface Props {
  experience: ExperienceItem[];
}

const { experience } = Astro.props;
---

<section class="space-y-8 sm:space-y-10">
  <h2 class="text-2xl sm:text-3xl font-bold text-white flex items-center gap-3">
    Experiencia
    <div class="h-px bg-zinc-800 flex-grow ml-4"></div>
  </h2>
  <div class="space-y-10 sm:space-y-12 border-l-2 border-zinc-800/50 pl-4 sm:pl-6 ml-2 relative">
    {experience.map(exp => (
      <div class="relative group">
        <div class="absolute -left-[21px] sm:-left-[31px] top-2 w-3 h-3 sm:w-4 sm:h-4 rounded-full bg-zinc-900 border-2 border-zinc-700 group-hover:border-portfolio-accent group-hover:bg-portfolio-accent/20 transition-all duration-300 shadow-[0_0_0_4px_rgba(24,31,42,1)]"></div>
        <h3 class="font-bold text-lg sm:text-xl text-white group-hover:text-portfolio-accent transition-colors">
          {exp.role} <span class="text-portfolio-muted">@</span> {exp.company}
        </h3>
        <span class="inline-block mt-1 px-2 py-0.5 rounded text-[10px] sm:text-xs text-portfolio-muted font-mono bg-white/5 border border-white/5">
          {exp.date}
        </span>
        <p class="mt-3 sm:mt-4 text-sm sm:text-base text-zinc-400 leading-relaxed max-w-3xl">
          {exp.desc}
        </p>
        
        {exp.techs && (
          <div class="flex flex-wrap gap-1.5 sm:gap-2 mt-3 sm:mt-4">
            {exp.techs.map(techName => {
              const techInfo = technologies.find(t => t.name === techName);
              return (
                <span class="flex items-center gap-1 sm:gap-1.5 px-2 sm:px-2.5 py-0.5 sm:py-1 text-[10px] sm:text-xs font-mono text-portfolio-muted bg-white/5 rounded-md border border-white/5 hover:border-portfolio-accent/30 hover:bg-portfolio-accent/5 transition-colors cursor-default">
                  {techInfo?.icon && <img src={techInfo.icon} alt={techName} class="w-3 h-3 sm:w-3.5 sm:h-3.5 opacity-80" loading="lazy" />}
                  {techName}
                </span>
              );
            })}
          </div>
        )}
      </div>
    ))}
  </div>
</section>
