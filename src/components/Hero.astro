---
interface Props {
  name: string;
  role: string;
}

const { name, role } = Astro.props;
---

<section class="space-y-6">
  <div class="flex items-center gap-4 sm:gap-5">
    <div class="relative shrink-0">
      <img
        src="/profile.jpg"
        alt={name}
        class="relative w-14 h-14 sm:w-16 sm:h-16 rounded-full object-cover border-2 border-white/10"
      />
    </div>
    <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-white tracking-tighter pb-2">
      {name}
    </h1>
  </div>

  <div class="flex flex-wrap items-center gap-3">
    <p class="text-lg sm:text-xl md:text-2xl text-portfolio-muted font-light max-w-2xl leading-relaxed">
      {role}
    </p>

    <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-white/5 border border-white/5 text-xs sm:text-sm text-portfolio-muted">
      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-portfolio-accent">
        <circle cx="12" cy="12" r="10"></circle>
        <polyline points="12 6 12 12 16 14"></polyline>
      </svg>
      <span id="caracas-clock">--:--:--</span>
      <span class="text-portfolio-accent">America/Caracas</span>
    </span>
  </div>
</section>

<script is:inline>
  (function () {
    var el = document.getElementById('caracas-clock');
    if (!el) return;
    var formatter = new Intl.DateTimeFormat('es-VE', {
      timeZone: 'America/Caracas',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: false,
    });
    var tick = function () {
      el.textContent = formatter.format(new Date());
    };
    tick();
    setInterval(tick, 1000);
  })();
</script>
