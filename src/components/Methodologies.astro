---
interface Methodology {
  name: string;
  icon: string;
}

interface Props {
  methodologies: Methodology[];
}

const { methodologies } = Astro.props;
---

<section class="space-y-6">
  <h2 class="text-2xl sm:text-3xl font-bold text-white flex items-center gap-3">
    Competencias
    <div class="h-px bg-gradient-to-r from-portfolio-muted/50 to-transparent flex-grow ml-4"></div>
  </h2>

  <ul class="space-y-2.5">
    {methodologies.map(item => (
      <li class="group flex items-center gap-4 p-3 sm:p-3.5 bg-portfolio-panel border border-white/5 rounded-2xl hover:border-portfolio-accent/40 transition-all duration-300">
        <span class="flex items-center justify-center w-10 h-10 sm:w-11 sm:h-11 shrink-0 rounded-xl bg-white/5 border border-white/5 group-hover:bg-portfolio-accent/10 group-hover:border-portfolio-accent/20 transition-colors">
          <span
            class="w-4 h-4 sm:w-5 sm:h-5 bg-current text-portfolio-muted group-hover:text-portfolio-accent transition-colors"
            style={`-webkit-mask:url('${item.icon}') center / contain no-repeat; mask:url('${item.icon}') center / contain no-repeat;`}
            aria-hidden="true"
          ></span>
        </span>
        <span class="text-sm sm:text-[15px] font-medium text-white group-hover:text-portfolio-accent transition-colors leading-snug">
          {item.name}
        </span>
      </li>
    ))}
  </ul>
</section>
