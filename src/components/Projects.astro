---
import { technologies } from "../data/config";

interface Project {
  title: string;
  desc: string;
  features?: string[];
  tags: string[];
  url?: string;
  gitHub?: string;
}

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<section class="space-y-6">
  <div class="flex items-center justify-between gap-4">
    <h2 class="text-2xl sm:text-3xl font-bold text-white flex items-center gap-3 flex-grow min-w-0">
      Proyectos
      <div class="h-px bg-gradient-to-r from-portfolio-muted/50 to-transparent flex-grow"></div>
    </h2>
    <div class="flex gap-2 shrink-0">
      <button id="carousel-prev" class="p-2 rounded-lg bg-portfolio-panel border border-white/10 text-portfolio-muted hover:text-white hover:border-portfolio-accent/40 transition-colors disabled:opacity-30 disabled:cursor-not-allowed" aria-label="Anterior">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>
      <button id="carousel-next" class="p-2 rounded-lg bg-portfolio-panel border border-white/10 text-portfolio-muted hover:text-white hover:border-portfolio-accent/40 transition-colors disabled:opacity-30 disabled:cursor-not-allowed" aria-label="Siguiente">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
    </div>
  </div>
  <div id="carousel-track" class="flex gap-6 overflow-x-auto snap-x snap-mandatory scroll-smooth pb-4 -mx-6 px-6 no-scrollbar" style="will-change: scroll-position;">
    {projects.map(project => (
      <div class="group shrink-0 flex flex-col w-[85vw] md:w-[42vw] lg:w-[30vw] snap-center relative p-6 bg-gradient-to-br from-portfolio-panel/90 to-portfolio-bg/70 backdrop-blur-sm border border-white/5 rounded-2xl hover:border-portfolio-accent/30 transition-all duration-300 hover:shadow-2xl hover:shadow-portfolio-accent/10 overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-br from-portfolio-accent/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        <h3 class="font-bold text-xl text-white mb-2 relative z-10 group-hover:text-portfolio-accent transition-colors">
          {project.title}
        </h3>
        <p class="text-sm text-portfolio-muted mb-4 leading-relaxed relative z-10">
          {project.desc}
        </p>
        {project.features && (
          <ul class="space-y-1.5 mb-4 relative z-10">
            {project.features.map(feature => (
              <li class="flex items-start gap-2 text-xs sm:text-sm text-portfolio-muted leading-relaxed">
                <span class="mt-[6px] w-1 h-1 rounded-full bg-portfolio-accent shrink-0"></span>
                <span>{feature}</span>
              </li>
            ))}
          </ul>
        )}
        <div class="flex flex-wrap gap-2 relative z-10 mb-5">
          {project.tags.map(techName => {
            const techInfo = technologies.find(t => t.name === techName);
            return (
              <span class="flex items-center gap-1.5 px-2 py-1 text-[10px] text-portfolio-muted bg-white/5 rounded border border-white/5 uppercase tracking-widest">
                {techInfo?.icon && <img src={techInfo.icon} alt={techName} class="w-3 h-3 opacity-90" loading="lazy" />}
                {techName}
              </span>
            );
          })}
        </div>
        {(project.url || project.gitHub) && (
          <div class="flex items-center gap-2 relative z-10 mt-auto">
            {project.url && (
              <a
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-4 py-2 text-sm font-bold text-white bg-portfolio-panel border border-white/10 rounded-lg hover:bg-portfolio-accent hover:text-portfolio-bg transition-all duration-300"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg>
                Demo
              </a>
            )}
            {project.gitHub && (
              <a
                href={project.gitHub}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-4 py-2 text-sm font-bold text-white bg-portfolio-panel border border-white/10 rounded-lg hover:bg-portfolio-accent hover:text-portfolio-bg transition-all duration-300"
              >
                <img src="https://cdn.simpleicons.org/github/white" alt="GitHub" class="w-4 h-4" />
                Código
              </a>
            )}
          </div>
        )}
      </div>
    ))}
  </div>
</section>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script is:inline>
  (function() {
    var track = document.getElementById('carousel-track');
    var prevBtn = document.getElementById('carousel-prev');
    var nextBtn = document.getElementById('carousel-next');

    if (!track || !prevBtn || !nextBtn) return;

    var isDown = false;
    var startX = 0;
    var scrollStart = 0;
    var rafId = 0;
    var autoplayId = null;
    var AUTOPLAY_DELAY = 4000;
    var isVisible = true;

    var updateButtons = function() {
      var maxScroll = track.scrollWidth - track.clientWidth;
      prevBtn.disabled = track.scrollLeft <= 0;
      nextBtn.disabled = track.scrollLeft >= maxScroll - 2;
    };

    var getScrollAmount = function() {
      var card = track.querySelector('.snap-center');
      if (!card) return track.clientWidth * 0.8;
      return card.offsetWidth + 24;
    };

    var startDrag = function(clientX) {
      isDown = true;
      track.style.cursor = 'grabbing';
      track.style.userSelect = 'none';
      track.style.scrollSnapType = 'none';
      track.style.scrollBehavior = 'auto';
      startX = clientX;
      scrollStart = track.scrollLeft;
    };

    var endDrag = function() {
      if (!isDown) return;
      isDown = false;
      track.style.cursor = 'grab';
      track.style.removeProperty('user-select');
      track.style.scrollSnapType = 'x mandatory';
      track.style.scrollBehavior = 'smooth';

      var target = Math.round(track.scrollLeft / getScrollAmount()) * getScrollAmount();
      track.scrollTo({ left: target, behavior: 'smooth' });
      restartAutoplay();
    };

    var moveDrag = function(clientX) {
      if (!isDown) return;
      var walk = (startX - clientX) * 1.5;
      cancelAnimationFrame(rafId);
      rafId = requestAnimationFrame(function() {
        track.scrollLeft = scrollStart + walk;
      });
    };

    track.addEventListener('mousedown', function(e) { e.preventDefault(); startDrag(e.pageX); });
    track.addEventListener('mouseleave', endDrag);
    track.addEventListener('mouseup', endDrag);
    track.addEventListener('mousemove', function(e) { moveDrag(e.pageX); });

    track.addEventListener('touchstart', function(e) { startDrag(e.touches[0].pageX); }, { passive: true });
    track.addEventListener('touchend', endDrag);
    track.addEventListener('touchmove', function(e) { moveDrag(e.touches[0].pageX); }, { passive: true });

    var goNext = function() {
      var maxScroll = track.scrollWidth - track.clientWidth;
      if (maxScroll <= 0) return;
      if (track.scrollLeft >= maxScroll - 2) {
        track.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        track.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
      }
    };

    var startAutoplay = function() {
      stopAutoplay();
      autoplayId = setInterval(function() {
        if (isDown || !isVisible) return;
        goNext();
      }, AUTOPLAY_DELAY);
    };

    var stopAutoplay = function() {
      if (autoplayId !== null) {
        clearInterval(autoplayId);
        autoplayId = null;
      }
    };

    var restartAutoplay = function() {
      stopAutoplay();
      startAutoplay();
    };

    prevBtn.addEventListener('click', function() {
      track.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
      restartAutoplay();
    });

    nextBtn.addEventListener('click', function() {
      track.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
      restartAutoplay();
    });

    document.addEventListener('visibilitychange', function() {
      isVisible = !document.hidden;
      if (isVisible) startAutoplay(); else stopAutoplay();
    });

    track.addEventListener('scroll', updateButtons, { passive: true });
    window.addEventListener('resize', updateButtons);
    updateButtons();

    track.style.cursor = 'grab';
    startAutoplay();
  })();
</script>
