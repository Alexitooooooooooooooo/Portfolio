---
import { technologies } from "../data/config";

interface MainTech {
  name: string;
  icon: string;
  desc: string;
}

interface Props {
  mainTechs: MainTech[];
  otherTechs: string[];
}

const { mainTechs, otherTechs } = Astro.props;

const otherWithIcons = otherTechs.map(name => technologies.find(t => t.name === name) || { name, icon: undefined });
---

<section class="space-y-6">
  <h2 class="text-2xl sm:text-3xl font-bold text-white flex items-center gap-3">
    Tecnologías
    <div class="h-px bg-gradient-to-r from-portfolio-muted/50 to-transparent flex-grow ml-4"></div>
  </h2>

  <!-- Stack principal -->
  <div class="space-y-3">
    <div class="flex items-center gap-3">
      <span class="px-2.5 py-1 text-[10px] font-mono uppercase tracking-widest text-portfolio-accent bg-portfolio-accent/10 border border-portfolio-accent/20 rounded-md">Main</span>
      <span class="text-xs sm:text-sm text-portfolio-muted">Stack principal — donde aporto más valor</span>
    </div>

    <div class="grid grid-cols-2 gap-3 sm:gap-4">
      {mainTechs.map(tech => (
        <div class="group relative rounded-2xl p-px bg-gradient-to-br from-teal-300 via-cyan-400 to-blue-500">
          <div class="relative flex flex-col items-center justify-center gap-2 rounded-[15px] bg-portfolio-panel px-3 py-4 sm:py-5 h-full overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-portfolio-accent/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            <span class="relative flex items-center justify-center w-11 h-11 sm:w-12 sm:h-12 rounded-xl bg-white/5 border border-white/5 group-hover:border-portfolio-accent/20 group-hover:bg-portfolio-accent/10 transition-colors">
              <img src={tech.icon} alt={tech.name} class="w-6 h-6 sm:w-7 sm:h-7" loading="lazy" />
            </span>
            <span class="relative text-xs sm:text-sm font-semibold text-white text-center leading-tight group-hover:text-portfolio-accent transition-colors">
              {tech.name}
            </span>
            <span class="relative text-[10px] sm:text-[11px] text-portfolio-muted text-center leading-tight opacity-100 sm:opacity-0 sm:group-hover:opacity-100 transition-opacity duration-300">
              {tech.desc}
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Otras tecnologías -->
  <div class="space-y-3 pt-1">
    <div class="flex flex-wrap items-center gap-3">
      <span class="px-2.5 py-1 text-[10px] font-mono uppercase tracking-widest text-portfolio-muted bg-white/5 border border-white/5 rounded-md">Explorando</span>
      <span class="text-xs sm:text-sm text-portfolio-muted">Por curiosidad y proyectos de aprendizaje</span>
    </div>

    <div class="flex flex-wrap gap-2">
      {otherWithIcons.map(tech => (
        <span class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white/5 border border-white/5 text-[11px] font-mono text-portfolio-muted hover:text-portfolio-accent hover:border-portfolio-accent/30 transition-colors cursor-default">
          {tech.icon && <img src={tech.icon} alt={tech.name} class="w-3.5 h-3.5 opacity-80" loading="lazy" />}
          {tech.name}
        </span>
      ))}
    </div>
  </div>
</section>
